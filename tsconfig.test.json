{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "composite": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".test-out",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "plugins": []
  },
  "include": [
    "lib/world/**/*.ts",
    "lib/mejora/**/*.ts",
    "lib/mercado/**/*.ts",
    "lib/negocio/niveles.ts",
    "lib/negocio/plan.ts",
    "lib/negocio/sugerencias.ts",
    "lib/negocio/sello.ts",
    "lib/negocio/vendedor.ts",
    "lib/negocio/__tests__/**/*.ts",
    "lib/pagos/**/*.ts",
    "lib/mundo.ts",
    "lib/ranks.ts",
    "lib/domains.ts",
    "lib/impact.ts",
    "lib/imagen-segura.ts",
    "lib/inicio/impacto.ts",
    "lib/inicio/puentes.ts",
    "lib/inicio/__tests__/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
